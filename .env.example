# --- required --------------------------------------------------------------
ANTHROPIC_API_KEY=your_anthropic_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# --- optional (defaults shown) ---------------------------------------------
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Exact browser origins allowed to call the API, comma-separated.
# CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Regex for origins whose hostname varies, e.g. Vercel preview deployments:
# CORS_ALLOW_ORIGIN_REGEX=https://multi-agent-research-.*\.vercel\.app

# RESEARCH_TIMEOUT_SECONDS=180
# MAX_RESEARCH_RETRIES=1
# MAX_ACTIVE_SESSIONS=50
